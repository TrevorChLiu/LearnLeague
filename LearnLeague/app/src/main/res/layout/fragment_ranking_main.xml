<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".RankingMainFragment">

    <Toolbar
        android:id="@+id/ranking_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:titleTextColor="@color/design_default_color_on_primary"
        android:background="@color/dark_gray"
        app:layout_constraintTop_toTopOf="parent"
        >
        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ranking"
            android:textColor="@color/design_default_color_background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_gravity="center" />
    </Toolbar>



    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout_ranking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_gray"
        app:layout_constraintTop_toBottomOf="@+id/ranking_title"
        >

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_day"
            android:text="Today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_week"
            android:text="This week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_month"
            android:text="This month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2_ranking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout_ranking"
        />

</androidx.constraintlayout.widget.ConstraintLayout>